generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id          String    @id @default(uuid())
  title       String    @default("New Conversation")
  personality String    @default("nova")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String
  thinking       String?
  timestamp      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model KnowledgeEntry {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String   @default("general")
  tags      String   @default("[]")
  userId    String?  // null = global/system knowledge, set = user-specific
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plugin {
  id          String   @id @default(uuid())
  name        String
  description String
  icon        String
  category    String
  version     String
  author      String
  installed   Boolean  @default(false)
  config      String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model Backup {
  id        String   @id @default(uuid())
  size      String
  location  String
  encrypted Boolean  @default(true)
  createdAt DateTime @default(now())
}

model UpdateQueue {
  id          String   @id @default(uuid())
  component   String
  description String
  riskLevel   String   @default("low")
  status      String   @default("pending")
  diff        String?
  createdAt   DateTime @default(now())
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String   @default("")
  status      String   @default("todo")
  priority    String   @default("medium")
  dueDate     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CalendarEvent {
  id          String   @id @default(uuid())
  title       String
  date        String
  time        String?
  type        String   @default("event")
  description String?
  createdAt   DateTime @default(now())
}

model Note {
  id          String   @id @default(uuid())
  title       String
  content     String
  category    String   @default("general")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PasswordEntry {
  id        String   @id @default(uuid())
  name      String
  username  String
  password  String
  url       String?
  category  String   @default("general")
  createdAt DateTime @default(now())
}

model Automation {
  id      String   @id @default(uuid())
  name    String
  trigger String
  action  String
  enabled Boolean  @default(true)
  lastRun DateTime?
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FeatureFlag {
  id              String   @id @default(uuid())
  key             String   @unique
  name            String
  description     String
  category        String   @default("general")
  enabled         Boolean  @default(true)
  configurable    Boolean  @default(true)
  requiresRestart Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdminLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  userId    String
  timestamp DateTime @default(now())
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  name          String?
  avatar        String?
  role          String    @default("user")  // admin, user
  tier          String    @default("free")  // free, basic, pro, enterprise, unlimited
  emailVerified Boolean   @default(false)
  isActive      Boolean   @default(true)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  sessions       Session[]
  apiKeys        UserApiKey[]
  usageRecords   UsageRecord[]
  auditLogs      AuditLog[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserApiKey {
  id          String   @id @default(uuid())
  userId      String
  provider    String   // openai, anthropic, google, cohere, mistral, custom
  apiKey      String   // encrypted
  apiSecret   String?  // encrypted
  baseUrl     String?  // custom endpoint
  label       String?  // user's label for this key
  isActive    Boolean  @default(true)
  lastUsed    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GlobalApiKey {
  id          String   @id @default(uuid())
  provider    String   @unique // openai, anthropic, google, cohere, mistral, custom
  apiKey      String   // encrypted
  apiSecret   String?
  baseUrl     String?
  isActive    Boolean  @default(true)
  minTier     String   @default("free") // minimum tier required to use
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UsageRecord {
  id          String   @id @default(uuid())
  userId      String
  action      String   // chat, image_gen, web_search, code_execute, etc.
  provider    String?  // which AI provider was used
  tokensUsed  Int      @default(0)
  cost        Float    @default(0)
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TierLimit {
  id                String  @id @default(uuid())
  tier              String  @unique
  maxChatsPerDay    Int     @default(50)
  maxImageGenPerDay Int     @default(10)
  maxWebSearchPerDay Int    @default(20)
  maxCodeExecPerDay Int     @default(20)
  maxStorageMB      Int     @default(100)
  maxPlugins        Int     @default(5)
  maxKnowledgeBase  Int     @default(100)
  canUseGlobalAPIs  Boolean @default(false)
  canCreatePlugins  Boolean @default(false)
  canAccessAdmin    Boolean @default(false)
  priority          Int     @default(0)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IntegrationSource {
  id              String   @id @default(uuid())
  name            String
  description     String   @default("")
  type            String   @default("github")  // github, gitlab, sourceforge, npm, pypi, custom_zip, custom_url
  url             String
  version         String   @default("latest")
  author          String   @default("unknown")
  license         String   @default("Unknown")
  category        String   @default("Custom")
  status          String   @default("pending")  // pending, installing, installed, error, disabled
  error           String?
  config          String   @default("{}")
  featureFlagKey  String?
  installedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AIRule {
  id          String   @id @default(uuid())
  title       String
  description String   // The rule text that the AI must follow
  category    String   @default("ethics")  // ethics, limitations, behavior, custom
  enabled     Boolean  @default(true)
  priority    Int      @default(0)  // Higher priority rules override lower ones
  isSystem    Boolean  @default(false)  // System rules cannot be deleted, only toggled
  source      String   @default("admin")  // admin, auto-generated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIActionApproval {
  id          String   @id @default(uuid())
  userId      String   // Who requested
  actionType  String   // db_read, db_write, code_read, code_write, config_read, config_write
  description String   // What the AI wants to do
  target      String   // Target resource (table name, file path, etc.)
  payload     String?  // JSON with the proposed change
  status      String   @default("pending")  // pending, approved, rejected, expired
  reviewedBy  String?  // Admin who approved/rejected
  reviewNote  String?
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
}
